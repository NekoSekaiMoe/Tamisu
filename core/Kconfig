menu "Tamisu"

config TAMISU
	  tristate "Tamisu Zygisk provider support"
	  depends on ARM64
	  default m
	  help
		Tamisu is a kernel-level Zygisk provider (à la ZygiskNext),
		not a root provider. It coexists with a separate root solution
		(KernelSU, Magisk, APatch) and owns only zygote injection.

		Only loadable kernel module (LKM, =m) is supported.
		Built-in (=y) is not supported.
		The module will be called tamisu.

config TAMISU_DEBUG
	  bool "Tamisu debug mode"
	  depends on TAMISU
	  default n
	  help
		Enable Tamisu debug mode (verbose klog).

endmenu
